  "title": "Bisquit Plan Info",
  "description": "Search live Bisquit.Host game, VDS, and bot hosting plans",
  "icon": "extension-icon.png",
  "author": "thomas",
  "license": "MIT",
  "commands": [
    {
      "name": "search-plans",
